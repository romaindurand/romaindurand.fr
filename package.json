{
	"name": "romaindurand.fr",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && ./fix_esm_error.sh",
		"preview": "vite preview",
		"start": "node -r dotenv/config build",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test:unit": "vitest",
		"postinstall": "prisma generate",
		"db:push": "prisma db push"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@prisma/client": "^7.10.1",
		"@shikijs/rehype": "^4.5.0",
		"@shikijs/twoslash": "^4.5.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"@types/uuid": "^11.0.0",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.8",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"lru-cache": "^11.5.3",
		"mdsvex": "^0.12.8",
		"monaco-editor": "^0.57.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^7.10.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-youtube-lite": "^1.4.1",
		"tailwindcss": "^4.3.3",
		"typescript": "6",
		"typescript-eslint": "^8.71.2",
		"unified": "^11.0.5",
		"uuid": "^14.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/components/*"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "7.10.1",
		"better-sqlite3": "12.6.0"
	}
}
